{
  "name": "tianyin-xiaojian-st",
  "version": "1.14.0",
  "private": true,
  "type": "module",
  "description": "Build tooling for the personal Tianyin Xiaojian project.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --platform=browser --target=es2020 --outfile=index.js --legal-comments=none --minify-syntax --minify-whitespace",
    "build:loader": "node scripts/build-loader.mjs",
    "check:syntax": "node --check index.js && node --check loader/tianyin-loader.js",
    "check:ai": "node scripts/check-ai.mjs",
    "check:emoji": "node scripts/check-emoji.mjs",
    "check:storage-emoji": "node scripts/check-storage-emoji.mjs",
    "check:behavior": "node scripts/check-behavior.mjs",
    "check:interactive": "node scripts/check-interactive.mjs",
    "check:community-prompts": "node scripts/check-community-prompts.mjs",
    "check:community-desktop": "node scripts/check-community-desktop.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:video": "node scripts/check-video.mjs",
    "check:shop": "node scripts/check-shop.mjs",
    "check:pending": "node scripts/check-pending.mjs",
    "check:press": "node scripts/check-press-gesture.mjs",
    "check:ambient": "node scripts/check-ambient.mjs",
    "check:cropper": "node scripts/check-cropper.mjs",
    "check:calendar": "node scripts/check-calendar.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:story-oracle": "node scripts/check-story-oracle.mjs",
    "check:today-trend": "node scripts/check-today-trend.mjs",

    "check:desktop-icons": "node scripts/check-desktop-icons.mjs",
    "check:appearance-pack": "node scripts/check-appearance-pack.mjs",
    "check:chat-metadata": "node scripts/check-chat-metadata.mjs",
    "check:community-files": "node scripts/check-community-files.mjs",
    "check:phone-images": "node scripts/check-phone-images.mjs",
    "check:igs-feed": "node scripts/check-igs-feed.mjs",
    "check:igs-chat": "node scripts/check-igs-chat.mjs",
    "check:community-rollback": "node scripts/check-community-rollback.mjs",
    "check:b2-feeds": "node scripts/check-b2-feeds.mjs",
    "check:origin-core": "node scripts/check-origin-core.mjs",
    "check:origin-host": "node scripts/check-origin-host.mjs",
    "check:plot-core": "node scripts/check-plot-core.mjs",
    "check:plot-host": "node scripts/check-plot-host.mjs",
    "check:plot-infinite": "node scripts/check-plot-infinite.mjs",
    "check": "npm run build && npm run check:syntax && npm run check:ai && npm run check:emoji && npm run check:storage-emoji && npm run check:behavior && npm run check:interactive && npm run check:community-prompts && npm run check:community-desktop && npm run check:live && npm run check:video && npm run check:shop && npm run check:origin-core && npm run check:origin-host && npm run check:plot-core && npm run check:plot-host && npm run check:plot-infinite && npm run check:igs-feed && npm run check:igs-chat && npm run check:community-rollback && npm run check:b2-feeds && npm run check:pending && npm run check:chat-metadata && npm run check:phone-images && npm run check:press && npm run check:ambient && npm run check:cropper && npm run check:calendar && npm run check:budget && npm run check:permissions && npm run check:contracts && npm run check:story-oracle && npm run check:today-trend && npm run check:desktop-icons && npm run check:appearance-pack"

  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "postcss": "^8.5.6"
  }
}
